; Apache-2.0 — ships with the public verifier repo.
; CDDL (RFC 8610) for verified-action-v1: contract objects, verdict input,
; verdict vector. The evidence/verdict objects are the JSON-compatible subset
; (text keys, no tags, integers only). The separately labelled B28 section is
; deterministic CBOR with byte strings; COSE_Sign1 is its external envelope.
; These shapes are FROZEN. Extending any enum or object requires updating
; ci/verdict_matrix.json, ci/verdict_input_schema.json, both engines and
; fixtures in the same commit (three-roles rule, A_BUILD §0.2).

; ---------- shared scalars ----------
hex32 = text .regexp "[0-9a-f]{64}"       ; SHA-256 hex
ts    = text                               ; RFC 3339 UTC
b64   = text

; ---------- closed verdict enums ----------
identity-result       = "VERIFIED" / "NOT_VERIFIED" / "CONFLICT"
authority-result      = "VERIFIED" / "NOT_VERIFIED" / "CONFLICT"
intent-result         = "RECORDED" / "NOT_RECORDED" / "CONFLICT"
outcome-result        = "CORROBORATED" / "CLAIM_ONLY" / "CONTRADICTED" / "ORPHAN"
linkage-result        = "DIRECT" / "DETERMINISTIC" / "AMBIGUOUS" / "NONE"
coverage-result       = "CLOSED" / "GAPPED" / "UNKNOWN"
integrity-result      = "VALID" / "INVALID"
; NOT_RECOMPUTED: the source DID sign, and THIS view cannot recompute it —
; materially different from NONE ("the source did not sign"). Recording a bank
; that signs its webhooks identically to one that does not understates evidence
; that genuinely exists. Per-view, exactly like mark-render (owner ruling
; 2026-08-04); B22.9 retains the proof material digest-addressed, so a fuller
; disclosure view lets a recipient recompute and earn ASYMMETRIC.
source-signature      = "ASYMMETRIC" / "SHARED_SECRET" / "NOT_RECOMPUTED" / "NONE"
control-domain        = "INDEPENDENT" / "OVERLAPPING" / "UNKNOWN"
node-observation      = "OBSERVED" / "NOT_OBSERVED"
client-attestation    = "ATTESTED" / "NONE"
coverage-basis        = "SOURCE_PROVEN_POPULATION" / "ATTESTED_NODE_FULL_SCAN" / "INSUFFICIENT"
node-integrity-basis  = "HARDWARE_ATTESTED" / "INDEPENDENTLY_ATTESTED" / "LOG_WITNESSED_SOFTWARE"
temporal-binding      = "PROVEN_SOURCE_ECHO" / "PROVEN_INDEPENDENT" / "UNPROVEN"
surface-mechanism     = "ENFORCED" / "OBSERVED" / "DECLARED" / "UNKNOWN"
surface-scope         = "DECLARED" / "OUT_OF_SCOPE" / "BOUNDARY_BREACH"
accountability-basis  = "SPONSOR_ASSERTED" / "PARENT_GUARANTEED" / "INSURER_CORROBORATED"
                      / "BONDED_OR_ESCROWED" / "UNKNOWN"
assurance-linkage     = "DIRECT" / "DETERMINISTIC" / "AMBIGUOUS" / "NONE"
scope-relation        = "RELATED" / "UNRELATED" / "UNKNOWN"
population-status     = "PROVEN" / "INDETERMINATE"
history-state         = "CLOSED_SINCE_BIRTH" / "NO_EVIDENCED_HISTORY_IN_PRESENTED_SCOPE"
; Legacy certificate-matrix input/output only. This is not swarrm-b28/v1
; authority, and no value in this enum can yield a favourable B28 result.
authority-proof       = "ACTION_SPECIFIC_AUTHORIZATION" / "DISCLOSED_LIMIT" / "NONE"
technical-eligibility = "ELIGIBLE" / "INELIGIBLE" / "NOT_RECOMPUTED"
registration-status   = "REGISTERED" / "PENDING" / "UNREGISTERED"
; MARK WITHDRAWN (owner audit 2026-08-03). "VERIFIED_CORROBORATED" and
; "VERIFIED_OBSERVED" are REMOVED from the wire format, not merely left
; unemitted: both were derivable from a subject's own declarations
; (source_signature reached ASYMMETRIC from a `verified: true` boolean plus
; key-NAME equality, with no signature bytes checked; control_domain reached
; INDEPENDENT from truthy strings), so a subject could award itself the top
; mark. A format that still ADMITS an unsafe value invites a producer to emit
; it. Both paths now render "UNMARKED_ASSURANCE_WITHDRAWN" — explicit, so a
; reader distinguishes "not proven yet" from "proven not to hold". Restoring
; the two values requires verifying their inputs against independently
; supplied trust roots, and is a wire-format change in its own right.
mark-render           = "UNMARKED_ASSURANCE_WITHDRAWN" / "UNMARKED_TECHNICAL"
                      / "UNMARKED_UNREGISTERED" / "PENDING_REGISTRATION" / "NOT_RECOMPUTED"

; ---------- lifecycle enums ----------
attestation-state  = "ISSUED" / "LAPSED" / "EXPIRED" / "REVOKED"       ; prospective only
finding-state      = "OPEN" / "UNDER_TRIAGE" / "RESOLVED_FACTUAL"
                   / "ACCEPTED_LIMITATION" / "EXPIRED"
registration-state = "ISSUED" / "AMENDED" / "EXPIRED" / "SUSPENDED"    ; append-only chain
proof-type         = "asymmetric_signature" / "mac" / "authenticated_read_transcript"
                   / "client_attestation"
key-provenance-method = "DOMAIN_CONTROL" / "TRUST_LIST" / "EXTERNAL_CA"
accountability-kind = "SPONSOR" / "PARENT" / "INSURER" / "BOND_ESCROW"   ; exact match; anything else never qualifies

; ---------- canonical scope descriptor (comparable; a digest is opaque) ----------
ScopeDescriptor = {
  org: text, source_system: text, account: text,
  action_classes: [* text],
  selector: { kind: text, predicates: { * text => [* text] } },
}

; ---------- B21.7 contract objects ----------
AgentActionClaim = {
  schema: "evd/claim/v1", action_id: text, action_class: text,
  ? value: text, ? currency: text, ? counterparty: text, ? external_ref: text,
  ? inputs_commitment: hex32, ? context_commitment: hex32,
}

SourceEvent = {
  schema: "evd/source-event/v1", event_key: text,            ; immutable source key
  source_identity_ref: text, outcome: text, finality: text,
  source_effect_time: ts,                                     ; SOURCE clock, never reconciled
  ? value: text, ? currency: text, ? counterparty: text, ? reference: text,
  ? proof_digests: [* hex32],                                 ; retained proof material
}

; ActionFact is the PAIRING of one claim with zero or one event plus verdicts —
; never a merged record.
ActionFact = {
  schema: "evd/action-fact/v1", claim: AgentActionClaim, ? event: SourceEvent,
  linkage: linkage-result, outcome: outcome-result,
}

SourceIdentity = {
  schema: "evd/source-identity/v1", source_system: text, account: text,
  declared_control_domain: control-domain, declared_controller: text,
  keys: [* { kid: text, algorithm_family: text, valid_from: ts, ? valid_to: ts }],
  ? rotation_pointer: text,
}

SourceBatch = {
  schema: "evd/source-batch/v1", source_identity_ref: text,
  ? period_start: ts, ? period_end: ts,                       ; required for a bound Node scan
  cursor_start: text, cursor_end: text, filter_digest: hex32,
  mapping_version: text, declared_count: uint, event_key_root: hex32,
  finality_watermark: text, exclusions: [* text], gaps: [* text],
  ? population_proof: { kind: text, source_scope_defined: bool, verified: bool },
}

SourceProof = {
  schema: "evd/source-proof/v1", proof_type: proof-type,
  material_digest: hex32,                                     ; digest-addressed, vault-retained
  key_identity: text, verified: bool,
  ? signature: b64,                                           ; legacy source-proof statement
  ? material: b64,                                            ; opt-in full view: exact retained raw bytes
  ? signature_context: "evd/source-webhook-body-jcs/v1",     ; strict raw envelope -> JCS(body)
}

; Cursor semantics: opaque, monotonic, source-defined; persisted only after the
; batch it closes is durably written. Rollback, reuse, or an inter-range gap is
; a finding and forces coverage GAPPED. Cursors are never reconstructed.

ControlDomainEvidence = {
  schema: "evd/control-evidence/v1", subject_party: text,
  claimed_control_domain: control-domain,
  ? legal_evidence: { source_registry: text, registry_id: text,
      ultimate_controller: text, retrieved_at: ts, retrieval_proof: hex32 },
  ? key_provenance: { method: key-provenance-method, evidence: text,
      valid_from: ts, ? valid_to: ts },
  operator_ultimate_controller: text, evaluator: text, ? signature: b64,
}

PopulationIndex = {
  schema: "evd/population-index/v1", org_id: hex32, population_class: text,
  ? dense_seq_range: { start: uint, end: uint }, ? tree_size: uint,
  ? checkpoint_ref: hex32, ? consistency_proof_ref: hex32,
  ? query_descriptor: ScopeDescriptor,                        ; canonical, not a digest
  ? result_root: hex32, ? count: uint, ? signature: b64,
}

NodeAttestation = {
  schema: "evd/node-attestation/v1", attester_identity: text,
  attester_control_domain: control-domain, deployment_id: text,
  node_public_key: b64, measured_digest: hex32,
  method: node-integrity-basis, valid_from: ts, valid_to: ts,
  state: attestation-state, ? continuity_requirements: text,
  ? revocation_pointer: text, signature: b64,
}

SurfaceEntry = {
  schema: "evd/surface/v1", birthtag_id: hex32, surface_id: text,
  surface_class: text, mechanism_declaration: surface-mechanism,
  controlling_party: text, ? evidence_source_ref: text,
  controller_grounded_independent: bool, controller_admits_overlap: bool,
  coverage_closed: bool, coverage_gap: bool,
  effective_from: ts, ? effective_to: ts, signature: b64,
}
AgentSurfaceManifest = { schema: "evd/surface-manifest/v1", entries: [* SurfaceEntry] }

ConnectorHealth = {
  schema: "evd/connector-health/v1", last_cursor: text, last_cursor_wall_time: ts,
  lag_seconds: uint, consecutive_failures: uint,
  credential_validity_remaining_s: uint, declared_algorithm_family: text,
  observed_algorithm_family: text, ? degradation_reason: text,
}

; ---------- registration / view objects (frozen HERE; B24 binds, B25 operates) ----------
ScopeRegistration = {
  schema: "evd/scope-registration/v1", registration_id: hex32, registry_key_id: text,
  covered_scope_digest: hex32, scope_description_digest: hex32,
  term_start: ts, term_end: ts, policy_version: text, policy_digest: hex32,
  band_commitment: hex32, entitlement_status: registration-state,
  ? prev_registration_id: hex32, signature: b64,
}
RegistrationIntent = {
  schema: "evd/registration-intent/v1", intent_id: hex32, statement_digest: hex32,
  scope_digest: hex32, policy_version: text, created_at_checkpoint: hex32,
  signature: b64,
}
RegistrationAttempt = {
  schema: "evd/registration-attempt/v1", attempt_id: hex32, intent_id: hex32,
  endpoint: text, attempted_at_checkpoint: hex32, transport_outcome: text,
  retry_count: uint, signature: b64,
}
VerificationViewManifest = {
  schema: "evd/view-manifest/v1", certificate_id: hex32,
  disclosed_field_set: [* text], withheld_field_set: [* text],
  policy_version: text, mark_result: mark-render, manifest_digest: hex32,
  signature: b64,
}

; ---------- B28 v1: one semantic profile, deterministic CBOR/COSE only ----------
; Each signed object below is carried inside the exact CWT claim map in the
; payload of tagged COSE_Sign1. The protected header is exactly
; {1:-8, 3:"application/eat+cwt", 4:kid}; the unprotected map is empty.
; Claim 265 is the EAT profile and -65537 is the IANA private-use typed core.
; Every `uint` below is non-negative but bounded by 2^63-1, the shared
; deterministic-CBOR signed-integer domain; values above that are malformed.
bstr32 = bytes .size 32
canonical-unsigned-decimal = text .regexp "0|[1-9][0-9]*"

AgentRefV1 = {
  schema: "swarrm-b28/agent-ref/v1", organisation_root: bstr32,
  birthtag: bstr32, revision: uint, agent_kid: text,
}
ResourceRefV1 = {
  schema: "swarrm-b28/resource-ref/v1", namespace: text,
  identifier_digest: bstr32,
}
PartyRefV1 = {
  schema: "swarrm-b28/party-ref/v1", party_id: text,
  organisation_root: bstr32,
}
ActionCoreV1 = {
  schema: "swarrm-b28/action-core/v1", action_id: bstr32, asa_id: bstr32,
  actor: AgentRefV1, operation: text, parameter_schema: text,
  parameter_digest: bstr32, value: canonical-unsigned-decimal, unit: text,
  source: ResourceRefV1, destination: ResourceRefV1,
  counterparty: PartyRefV1, recipient: AgentRefV1,
  grant_id: bstr32, grant_version: uint, policy_version: text,
  policy_digest: bstr32, nonce: bstr32, expires_at: uint,
}
ChallengeCoreV1 = {
  schema: "swarrm-b28/challenge-core/v1",
  profile: "https://swarrm.ai/spec/eat/b28/cwt/v1",
  challenger: AgentRefV1, action: ActionCoreV1,
  accepted_encodings: ["application/eat+cwt"],
  required_dimensions: [* text], max_checkpoint_age: uint, issued_at: uint,
}

; Root succession is not a CWT: both roots sign the same domain-separated
; deterministic-CBOR RootRotationV1 bytes in this exact public envelope.
RootRotationV1 = {
  schema: "swarrm-b28/root-rotation/v1", tenant: text,
  organisation_id: text, sequence: uint, rotation_id: bstr32,
  previous_rotation_digest: bstr32,
  old_organisation_root: bstr32, old_root_kid: text,
  old_root_public_key: bstr32, old_bundle_digest: bstr32,
  new_organisation_root: bstr32, new_root_kid: text,
  new_root_public_key: bstr32, new_bundle_digest: bstr32,
  effective_at: uint,
}
RootRotationEnvelopeV1 = {
  schema: "swarrm-b28/root-rotation-envelope/v1",
  core: RootRotationV1, old_signature: bytes .size 64,
  new_signature: bytes .size 64,
}

RootDelegationV1 = {
  schema: "swarrm-b28/root-delegation/v1", tenant: text,
  organisation_root: bstr32, delegation_id: bstr32,
  passport_authority_kid: text, passport_authority_key: bstr32,
  action_authority_kid: text, action_authority_key: bstr32,
  valid_from: uint, valid_to: uint,
}
; Profile invariant: passport_authority_key/kid and action_authority_key/kid MUST differ.
RegistrationTemplateV1 = {
  schema: "swarrm-b28/registration-template/v1", tenant: text,
  organisation_root: bstr32, template_id: bstr32, template_version: uint,
  owner: text, purpose: text, mandate_digest: bstr32, config_digest: bstr32,
  valid_from: uint, valid_to: uint,
}
AdminBindingV1 = {
  schema: "swarrm-b28/admin-binding/v1", tenant: text,
  organisation_root: bstr32, binding_id: bstr32, credential_id: bytes,
  cose_public_key: bytes, rp_id: text,
  role: "agent-registrar" / "security-admin" / "governance-admin",
  valid_from: uint, valid_to: uint, initial_state: "ACTIVE",
}
AdminSelectionV1 = {
  schema: "swarrm-b28/admin-selection/v1", tenant: text,
  binding_id: bstr32, template_id: bstr32, template_version: uint,
  proposed_agent_digest: bstr32, credential_id: bytes,
  challenge_id: bstr32, challenge: bstr32,
  client_data_json: bytes, authenticator_data: bytes, signature: bytes,
  selected_at: uint,
}
AdminChallengeV1 = {
  schema: "swarrm-b28/admin-challenge/v1", tenant: text,
  organisation_root: bstr32, challenge_id: bstr32, binding_id: bstr32,
  template_id: bstr32, template_version: uint,
  proposed_agent_digest: bstr32, challenge: bstr32,
  issued_at: uint, expires_at: uint,
}
AdminConsumptionV1 = {
  schema: "swarrm-b28/admin-consumption/v1", tenant: text,
  organisation_root: bstr32, binding_id: bstr32, challenge_id: bstr32,
  challenge_digest: bstr32, selection_digest: bstr32,
  credential_digest: bstr32,
  counter_version: uint, sign_count_before: uint, sign_count_after: uint,
  backup_eligible: bool, backup_state: bool, consumed_at: uint,
}
AgentPoPV1 = {
  schema: "swarrm-b28/agent-pop/v1", tenant: text, birthtag: bstr32,
  revision: uint, agent_kid: text, proposed_agent_digest: bstr32,
  challenge: bstr32,
}
AgentCredentialV1 = {
  schema: "swarrm-b28/agent-credential/v1", tenant: text,
  organisation_root: bstr32, authority_delegation_id: bstr32,
  birthtag: bstr32, revision: uint, agent_kid: text, agent_key: bstr32,
  owner: text, purpose: text, mandate_digest: bstr32, config_digest: bstr32,
  template_id: bstr32, template_version: uint, principal_binding_id: bstr32,
  admin_selection_digest: bstr32, agent_pop_digest: bstr32,
  agent_successor_digest: bstr32 / null,
  issuance_checkpoint: bstr32, valid_from: uint, valid_to: uint,
}
AgentSuccessorV1 = {
  schema: "swarrm-b28/agent-successor/v1", tenant: text,
  organisation_root: bstr32, predecessor_birthtag: bstr32,
  predecessor_revision: uint, predecessor_credential_digest: bstr32,
  successor_birthtag: bstr32, successor_revision: 1,
  successor_proposal_digest: bstr32, effective_at: uint,
}
LimitGrantV1 = {
  schema: "swarrm-b28/limit-grant/v1", tenant: text,
  organisation_root: bstr32, grant_id: bstr32, grant_version: uint,
  authority_delegation_id: bstr32, actor_birthtag: bstr32,
  recipient_organisation_root: bstr32, operation: text, unit: text,
  action_scope_digest: bstr32,
  kind: "ONE_SHOT" / "FLOW" / "STOCK", ceiling: canonical-unsigned-decimal,
  window_start: uint, window_end: uint, valid_from: uint, valid_to: uint,
  max_unresolved_exposure: canonical-unsigned-decimal,
}

AuthorityStateValueV1 = {
  key: bstr32, state: "ACTIVE" / "REVOKED" / "SUPERSEDED",
  version: uint, object_digest: bstr32,
}
AuthorityStateChangeV1 = {
  ; key = SHA-256("swarrm-authority-state/v1\0" || kind || "\0" || object_id)
  key: bstr32, kind: text, object_id: bytes,
  state: "ACTIVE" / "REVOKED" / "SUPERSEDED", version: uint,
  object_digest: bstr32,
}
AuthorityMutationV1 = {
  schema: "swarrm-b28/authority-mutation/v1", tenant: text,
  organisation_root: bstr32, sequence: uint, previous_root: bstr32,
  new_root: bstr32, changes: [+ AuthorityStateChangeV1], effective_at: uint,
}
AuthorityCheckpointV1 = {
  schema: "swarrm-b28/authority-checkpoint/v1", tenant: text,
  organisation_root: bstr32, sequence: uint, authority_root: bstr32,
  log_root: bstr32, log_size: uint, issued_at: uint,
}
AuthorityMembershipProofV1 = {
  schema: "swarrm-b28/authority-membership-proof/v1", key: bstr32,
  value: AuthorityStateValueV1, index: uint, tree_size: uint,
  path: [* bstr32],
}
AuthorityNonMembershipProofV1 = {
  schema: "swarrm-b28/authority-non-membership-proof/v1", key: bstr32,
  tree_size: uint,
  predecessor: AuthorityMembershipProofV1 / null,
  successor: AuthorityMembershipProofV1 / null,
}
StatusSnapshotV1 = {
  schema: "swarrm-b28/status-snapshot/v1", tenant: text,
  organisation_root: bstr32, authority_delegation_id: bstr32,
  checkpoint_digest: bstr32, proofs_digest: bstr32,
  status_as_of: uint, expires_at: uint,
}
AssumedRiskReleaseV1 = {
  schema: "swarrm-b28/assumed-risk-release/v1", tenant: text,
  organisation_root: bstr32, authority_delegation_id: bstr32, asa_id: bstr32,
  old_grant_id: bstr32, old_grant_version: uint,
  new_grant_id: bstr32, new_grant_version: uint,
  maximum_unresolved_exposure: canonical-unsigned-decimal, released_at: uint,
}

ASACoreV1 = {
  schema: "swarrm-b28/asa-core/v1", tenant: text,
  organisation_root: bstr32, authority_delegation_id: bstr32, asa_id: bstr32,
  action_digest: bstr32, challenge_digest: bstr32,
  grant_id: bstr32, grant_version: uint, reservation_state: "ISSUED_HELD",
  issued_at: uint, expires_at: uint,
}
AuthorityProofV1 = AuthorityMembershipProofV1 / AuthorityNonMembershipProofV1
PresentationCoreV1 = {
  schema: "swarrm-b28/presentation-core/v1",
  profile: "https://swarrm.ai/spec/eat/b28/cwt/v1",
  challenge_envelope_hash: bstr32, challenge_digest: bstr32,
  action_digest: bstr32, root_delegation: bytes,
  registration_template: bytes, admin_binding: bytes,
  admin_selection: bytes, admin_challenge: bytes, admin_consumption: bytes,
  agent_pop: bytes, agent_successor: bytes / null, passport: bytes,
  passport_holder_proof: bytes, limit_grant: bytes,
  authority_checkpoint: bytes, issuance_consistency_proof: [* bstr32],
  status_snapshot: bytes,
  state_proofs: {
    root_delegation: AuthorityProofV1,
    registration_template: AuthorityProofV1,
    mandate: AuthorityProofV1, agent_config: AuthorityProofV1,
    admin_binding: AuthorityProofV1, admin_selection: AuthorityProofV1,
    admin_challenge: AuthorityProofV1, admin_consumption: AuthorityProofV1,
    admin_counter: AuthorityProofV1,
    agent_pop: AuthorityProofV1, passport: AuthorityProofV1,
    agent_head: AuthorityProofV1,
    agent_successor: AuthorityProofV1 / null,
    predecessor_head: AuthorityProofV1 / null,
    limit_grant: AuthorityProofV1, grant_head: AuthorityProofV1,
  },
  asa: bytes, transcript_digest: bstr32,
  non_assertion: "This proves identity, current proof-bearing authority and durable replay at a bounded checkpoint. It does not evaluate Node, source, coverage, history or post-action evidence readiness in v1, predict behaviour, certify an outcome, establish later evidence, or express a Swarrm opinion.",
  created_at: uint,
}
RefusalCoreV1 = {
  schema: "swarrm-b28/refusal-core/v1",
  profile: "https://swarrm.ai/spec/eat/b28/cwt/v1",
  challenge_envelope_hash: bstr32, challenge_digest: bstr32,
  reason_code: text, created_at: uint,
}
B28TypedCoreV1 = ActionCoreV1 / ChallengeCoreV1 / ASACoreV1 /
  PresentationCoreV1 / RefusalCoreV1 / RootDelegationV1 /
  RegistrationTemplateV1 / AdminBindingV1 / AdminSelectionV1 /
  AdminChallengeV1 / AdminConsumptionV1 / AgentPoPV1 / AgentCredentialV1 /
  AgentSuccessorV1 /
  LimitGrantV1 / AuthorityMutationV1 / AuthorityCheckpointV1 /
  StatusSnapshotV1 / AssumedRiskReleaseV1
B28CWTClaimsV1 = {
  265 => "https://swarrm.ai/spec/eat/b28/cwt/v1",
  -65537 => B28TypedCoreV1,
}

; ---------- passport ----------
BirthtagPassportV1 = {
  schema: "evd/passport/v1", birthtag_id: hex32,
  bundle: { * text => any },                                  ; an ordinary evd/bundle/v1
  transfer: { birthtag_id: hex32, successor_root_kid: text,
              effective_ts: ts, transfer_sig: b64 },
}

; ---------- engine input ----------
VerdictInput = {
  schema: "evd/verdict-input/v1",
  action: { action_id: text, action_class: text, ? value: text, ? currency: text },
  authority: {                                                ; bundle-derived or supplied
    identity: identity-result, authority: authority-result, intent: intent-result,
    integrity: integrity-result,
    intent_interval: { lower: ts / null, upper: ts / null },
    ? subject_ids: { * text => hex32 },
    ? operator_entity: text,
  },
  ? claim: AgentActionClaim,
  ; A member that STEERS a CONTRADICTED verdict must be in the frozen schema.
  ; node/reconcile.py writes this in production and the engine consumes it, but
  ; it rode in undeclared through the certificate's `verdict_input: {* text =>
  ; any}` — so a producer could name a narrower list than the reconcile-v1 §5
  ; floor. Declared here; the floor rule in §5 is what bounds it.
  ? source_manifest: { material_fields: [* text] },
  ? events: [* SourceEvent],
  ? event_matches: [* { event_key: text, echoed_action_id: bool,
      immutable_ref_match: bool, unique_field_match: bool, final: bool,
      material_mismatch: bool }],
  ? source_identity: SourceIdentity,
  ? source_proofs: [* SourceProof],
  ? control_evidence: ControlDomainEvidence,
  ? control_declarations: [* { declarer: text, claims_overlap: bool }],
  ? batch: SourceBatch,
  ; batch_digest = sha256(JCS(batch)) — the scan statement NAMES WHAT IT SAW.
  ; Without it the signed bytes are identical for every clean scan and the
  ; signature replays onto any batch; absent/mismatched => NOT_OBSERVED (§2.4).
  ? scan: { performed: bool, complete: bool, cursor_gap_free: bool,
      authenticated_read: bool, node_signed: bool,
      ? batch_digest: hex32, ? node_id: text, ? signature: text },
  ? node_attestation: NodeAttestation,
  fork_findings_open: bool,
  ? population_index: PopulationIndex,
  ? surfaces: { manifest: AgentSurfaceManifest,
      activity: [* { surface_class: text, explained: bool }] },
  ? temporal: { ? source_effect_time: ts,
      echo: { echoed_intent_digest: bool, echoed_action_id: bool, echoed_nonce: bool },
      ? intent_bounds: { lower: ts, upper: ts, attester_independent: bool },
      ? event_bounds: { lower: ts, upper: ts, attester_independent: bool },
      source_clock_sync_declared: bool },
  ? registration: { ? scope_registration: { registration: ScopeRegistration,
        covers_scope: bool, term_valid: bool },
      ? intent: RegistrationIntent, ? attempts: [* RegistrationAttempt],
      scitt_receipt_valid: bool },
  ? view: { withheld_fields: [* text] },
  ? accountability: { bindings: [* { kind: accountability-kind, signed: bool,
      agent_specific: bool, mandate_specific: bool, value_bounded: bool,
      time_bounded: bool, externally_grounded: bool }] },
  ? assurance: { ? intent_digest: hex32, ? presented_transcript_digest: hex32,
      challenge_nonce_match: bool, candidates: uint },
  ; Legacy certificate-matrix input only; it is not a B28 presentation or ASA
  ; authority path and cannot yield a favourable B28 result.
  ? handshake_authority: { construction: authority-proof,
      ? asa_bindings_complete: bool, ? disclosed_limit_covers: bool },
  ? mandates: { presented_scope: ScopeDescriptor / hex32,
      candidates: [* { mandate_id: hex32, ? scope: ScopeDescriptor,
          scope_digest_only: bool, open_findings: uint }] },
  ? history: { born_with_evidence: bool,
      surfaces_closed_since_birth: [* text], evidenced_history_in_scope: bool },
  client_attestation_present: bool,
}

; ---------- engine output ----------
VerdictVector = {
  schema: "evd/verdict-vector/v1",
  identity: identity-result, authority: authority-result, intent: intent-result,
  outcome: outcome-result / null, linkage: linkage-result,
  coverage: coverage-result, integrity: integrity-result,
  source_signature: source-signature, control_domain: control-domain,
  node_observation: node-observation, client_attestation: client-attestation,
  coverage_basis: coverage-basis, node_integrity_basis: node-integrity-basis,
  temporal_binding: temporal-binding,
  intent_interval: { lower: ts / null, upper: ts / null },
  surfaces: [* { surface_id: text, mechanism: surface-mechanism,
      control_domain: control-domain, coverage: coverage-result }],
  out_of_scope_surfaces: [* text], boundary_breaches: [* text],
  accountability_basis: accountability-basis,
  assurance_linkage: assurance-linkage, scope_relation: scope-relation / null,
  population_status: population-status / null,
  history_state: { state: history-state, surfaces: [* text] } / null,
  authority_proof: authority-proof / null,
  technical_eligibility: technical-eligibility,
  registration_status: registration-status, mark: mark-render,
  ? subject_ids: { * text => hex32 },
}
